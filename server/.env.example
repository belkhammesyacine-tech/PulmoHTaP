# ============================================
# PulmoHTapAlgérie — Server Environment
# ============================================

# ── Server ──────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (Supabase PostgreSQL) ──────────
# Supabase → Settings → Database → URI (Transaction pooler)
DATABASE_URL="postgresql://postgres.ecfvtldvgmxtmsujvzoc:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (for Prisma migrations)
DIRECT_URL="postgresql://postgres.ecfvtldvgmxtmsujvzoc:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── JWT ─────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_strong_64char_random_secret
JWT_REFRESH_SECRET=change_this_to_another_strong_64char_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email (Gmail SMTP) ───────────────────────
# Gmail → Google Account → Security → App Passwords → Generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=belkhammesyacine@gmail.com
SMTP_PASS=[YOUR-GMAIL-APP-PASSWORD]
EMAIL_FROM="PulmoHTapAlgérie <belkhammesyacine@gmail.com>"

# ── App ─────────────────────────────────────
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
