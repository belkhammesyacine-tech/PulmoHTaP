  ADRAR
  CHLEF
  LAGHOUAT
  OUM_EL_BOUAGHI
  BATNA
  BEJAIA
  BISKRA
  BECHAR
  BLIDA
  BOUIRA
  TAMANRASSET
  TEBESSA
  TLEMCEN
  TIARET
  TIZI_OUZOU
  ALGER
  DJELFA
  JIJEL
  SETIF
  SAIDA
  SKIKDA
  SIDI_BEL_ABBES
  ANNABA
  GUELMA
  CONSTANTINE
  MEDEA
  MOSTAGANEM
  MSILA
  MASCARA
  OUARGLA
  ORAN
  EL_BAYADH
  ILLIZI
  BORDJ_BOU_ARRERIDJ
  BOUMERDES
  EL_TARF
  TINDOUF
  TISSEMSILT
  EL_OUED
  KHENCHELA
  SOUK_AHRAS
  TIPAZA
  MILA
  AIN_DEFLA
  NAAMA
  AIN_TEMOUCHENT
  GHARDAIA
  RELIZANE
  TIMIMOUN
  BORDJ_BADJI_MOKHTAR
  OULED_DJELLAL
  BENI_ABBES
  IN_SALAH
  IN_GUEZZAM
  TOUGGOURT
  DJANET
