// PulmoHTapAlgérie — Prisma Schema
// Generator + Datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AccountType {
  PATIENT
  DOCTOR
  SPECIALIST
  LABORATORY
  PHARMACY
  PSYCHOLOGIST
  RESEARCHER
  CLINIC_ADMIN
  PLATFORM_ADMIN
}

enum AccountStatus {
  PENDING      // بانتظار تفعيل البريد
  ACTIVE       // حساب مفعّل
  SUSPENDED    // موقوف من الإدارة
  DELETED      // محذوف (soft delete)
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW   // وثائق مرفوعة، بانتظار المراجعة
  VERIFIED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RecordType {
  DIAGNOSIS
  PRESCRIPTION
  LAB_TEST
  XRAY
  GENERAL_NOTE
}

