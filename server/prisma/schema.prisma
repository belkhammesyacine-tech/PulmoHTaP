// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  fullName     String
  email        String        @unique
  phone        String        @unique
  passwordHash String
  accountType  AccountType
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  lastLoginAt  DateTime?

  // Relations
  profile              UserProfile?
  sessions             Session[]
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  auditLogs            AuditLog[]
  doctorVerification   DoctorVerification?
  appointmentsPatient  Appointment[]       @relation("PatientAppointments")
  appointmentsDoctor   Appointment[]       @relation("DoctorAppointments")
  medicalRecords       MedicalRecord[]     @relation("PatientRecords")
  recordsAuthored      MedicalRecord[]     @relation("DoctorRecords")
  notifications        Notification[]
  messagesSent         Message[]           @relation("SentMessages")
  messagesReceived     Message[]           @relation("ReceivedMessages")

  @@index([email])
  @@index([phone])
  @@index([accountType])
  @@index([status])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl       String?
  language        String   @default("ar")
  country         String   @default("DZ")
  wilaya          Wilaya?
  address         String?
  emergencyContact String?
  privacySettings Json?
  updatedAt       DateTime @updatedAt
}

model Session {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String        @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  status       SessionStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime
  lastUsedAt   DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

// تحقق الهوية المهنية للأطباء والمختصين
model DoctorVerification {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String             // رقم رخصة مزاولة المهنة
  specialty       String?            // التخصص
  institution     String?            // المستشفى / المؤسسة
  documentUrl     String?            // رابط وثيقة الترخيص (Supabase Storage مستقبلاً)
  status          VerificationStatus @default(UNVERIFIED)
  reviewedBy      String?            // ID مدير المنصة الذي راجع الطلب
  reviewedAt      DateTime?
  rejectionReason String?
  submittedAt     DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // LOGIN | LOGOUT | REGISTER | VERIFY_EMAIL | PASSWORD_RESET | FAILED_LOGIN | etc.
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// APPOINTMENTS & MEDICAL RECORDS
// ─────────────────────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  doctorId    String
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor      User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date        DateTime          // تاريخ ووقت الموعد
  reason      String?           // سبب الزيارة
  status      AppointmentStatus @default(PENDING)
  notes       String?           // ملاحظات الطبيب
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
}

model MedicalRecord {
  id          String      @id @default(cuid())
  patientId   String
  doctorId    String
  patient     User        @relation("PatientRecords", fields: [patientId], references: [id])
  doctor      User        @relation("DoctorRecords", fields: [doctorId], references: [id])
  type        RecordType  @default(GENERAL_NOTE)
  title       String      // عنوان السجل (مثال: وصفة طبية، تشخيص)
  description String      @db.Text
  attachment  String?     // رابط لمرفق (PDF, صوره)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("INFO")  // INFO | SUCCESS | WARNING | DANGER
  isRead    Boolean  @default(false)
  link      String?  // مسار اختياري للتوجيه عند الضغط
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// ─────────────────────────────────────────────
// MESSAGES (Real-time Chat)
// ─────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sender     User     @relation("SentMessages",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}
